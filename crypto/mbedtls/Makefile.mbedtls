# SPDX-License-Identifier: GPL-2.0-only

##
# Configuration
#
# Mbed TLS is configured via a C header, mbedtls_config.h; and its
# internal crypto library, TF PSA Crypto, is configured via
# crypto_config.h. Based on the Barebox config, we select the minimum
# feature set here:

mbedtls-crypto-y := MBEDTLS_PSA_CRYPTO_C
mbedtls-crypto-y += MBEDTLS_PSA_CRYPTO_EXTERNAL_RNG
mbedtls-crypto-y += MBEDTLS_HAVE_INT32
mbedtls-crypto-y += MBEDTLS_PLATFORM_ZEROIZE_ALT

mbedtls-mbedtls-$(CONFIG_MBEDTLS_PKCS7) += MBEDTLS_PKCS7_C
mbedtls-mbedtls-$(CONFIG_MBEDTLS_PKCS7) += MBEDTLS_X509_USE_C
mbedtls-mbedtls-$(CONFIG_MBEDTLS_PKCS7) += MBEDTLS_X509_CRT_PARSE_C
mbedtls-mbedtls-$(CONFIG_MBEDTLS_PKCS7) += MBEDTLS_X509_CRL_PARSE_C
mbedtls-crypto-$(CONFIG_MBEDTLS_PKCS7) += PSA_WANT_ALG_SHA_256
mbedtls-crypto-$(CONFIG_MBEDTLS_PKCS7) += PSA_WANT_ALG_RSA_PKCS1V15_SIGN
mbedtls-crypto-$(CONFIG_MBEDTLS_PKCS7) += PSA_WANT_KEY_TYPE_RSA_PUBLIC_KEY
mbedtls-crypto-$(CONFIG_MBEDTLS_PKCS7) += PSA_WANT_KEY_TYPE_RSA_KEY_PAIR_BASIC
mbedtls-crypto-$(CONFIG_MBEDTLS_PKCS7) += MBEDTLS_MD_C
mbedtls-crypto-$(CONFIG_MBEDTLS_PKCS7) += MBEDTLS_PK_C
mbedtls-crypto-$(CONFIG_MBEDTLS_PKCS7) += MBEDTLS_PK_PARSE_C
mbedtls-crypto-$(CONFIG_MBEDTLS_PKCS7) += MBEDTLS_ASN1_PARSE_C


##
# Header generation logic
#
# Use the collected set of options above to generate the corresponding
# header files, taking care to only update them - and thus force a
# rebuild - whenever changes in the Barebox config requires it.

mbedtls-define = $(pound)define $(1)$(if $(filter PSA_%,$(1)), 1)
mbedtls-define-list = $(foreach def,$(sort $(1)),$(strip $(call mbedtls-define,$(def)))$(newline))
mbedtls-defines = $(subst $(newline) ,$(newline),$(call mbedtls-define-list,$(1)))

filechk_mbedtls-header = cat $(tmp-target).x; rm $(tmp-target).x

define mbedtls-config-gen

mbedtls-$(1)-header := $$(objtree)/crypto/mbedtls/$(1)_config.h

define mbedtls-$(1)-header-code
/* This file was automatically generated by Barebox, do not edit */
#ifndef $(2)_CONFIG_H
#define $(2)_CONFIG_H

#define $(2)_CONFIG_VERSION $(4)

$$(call mbedtls-defines,$$(mbedtls-$(1)-y))

#endif /* $(2)_CONFIG_H */
endef

$$(mbedtls-$(1)-header): FORCE
	$$(file >$$(tmp-target).x,$$(mbedtls-$(1)-header-code))
	$$(call filechk,mbedtls-header)

mbedtls-config-headers += $$(mbedtls-$(1)-header)
mbedtls-cppflags += -D$(3)_CONFIG_FILE='"$$(abspath $$(mbedtls-$(1)-header))"'
mbedtls-cmake-flags += -D$(3)_CONFIG_FILE=$$(abspath $$(mbedtls-$(1)-header))

endef

$(eval $(call mbedtls-config-gen,mbedtls,MBEDTLS,MBEDTLS,0x04000000))
$(eval $(call mbedtls-config-gen,crypto,PSA_CRYPTO,TF_PSA_CRYPTO,0x01000000))


##
# CMake build logic
#

mbedtls-srcdir := $(abspath $(CONFIG_MBEDTLS_SRC))
mbedtls-topdir := $(objtree)/crypto/mbedtls
mbedtls-objdir := $(mbedtls-topdir)/build

mbedtls-cmake-cflags := $(filter -m% -fpic -fpie -fno-pic -fno-pie,$(KBUILD_CFLAGS))
mbedtls-cmake-cflags += -Os -fno-stack-protector -ffunction-sections -fdata-sections
# Force mbedtls' own software inet_pton() for X.509 IP-address names; otherwise
# the hosted cmake build detects <arpa/inet.h> and references libc inet_pton(),
# which barebox does not provide. This is mbedtls' documented bypass define.
mbedtls-cmake-cflags += -DMBEDTLS_TEST_SW_INET_PTON

mbedtls-cmake-flags += -DENABLE_PROGRAMS=OFF
mbedtls-cmake-flags += -DENABLE_TESTING=OFF
mbedtls-cmake-flags += -DUSE_SHARED_MBEDTLS_LIBRARY=OFF
mbedtls-cmake-flags += -DUSE_STATIC_MBEDTLS_LIBRARY=ON
mbedtls-cmake-flags += -DMBEDTLS_FATAL_WARNINGS=OFF
mbedtls-cmake-flags += -DCMAKE_C_FLAGS="$(mbedtls-cmake-cflags)"

quiet_cmd_mbedtls-cmake = CMAKE   $(@D)
      cmd_mbedtls-cmake = cmake \
			-S $(mbedtls-srcdir) \
			-B $(mbedtls-objdir) \
			$(mbedtls-cmake-flags)

targets += $(mbedtls-objdir)/Makefile

$(mbedtls-objdir)/Makefile: $(mbedtls-config-headers) FORCE
	$(call if_changed,mbedtls-cmake)

include $(srctree)/crypto/mbedtls/mbedtls-libs.mk
mbedtls-libs := $(addprefix $(mbedtls-topdir)/,$(mbedtls-libs))

$(mbedtls-libs) &: $(mbedtls-objdir)/Makefile
	@$(kecho) '  BUILD   $(<D)'
	$(Q)$(MAKE) -C $(mbedtls-objdir)

##
# Integration with Barebox build system
#

# Consumers of Mbed TLS throughout the Barebox source tree must
# explicitly add the headers to their cc flags. Example:
#
# ccflags-y += $(mbedtls-ccflags)
#
export mbedtls-ccflags := \
	-I$(srctree)/crypto/mbedtls/include \
	-I$(mbedtls-srcdir)/include \
	-I$(mbedtls-srcdir)/tf-psa-crypto/include \
	-I$(mbedtls-srcdir)/tf-psa-crypto/drivers/builtin/include \
	$(mbedtls-cppflags)

prepare: $(mbedtls-libs)
